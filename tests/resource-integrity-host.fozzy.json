{
  "version": 1,
  "name": "resource-integrity-host",
  "steps": [
    {
      "type": "proc_spawn",
      "cmd": "env",
      "args": ["CARGO_INCREMENTAL=0", "cargo", "test", "--manifest-path", "backend/Cargo.toml", "-p", "babble-api", "--test", "body_limits"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "env",
      "args": [
        "CARGO_INCREMENTAL=0",
        "cargo",
        "test",
        "--manifest-path",
        "backend/Cargo.toml",
        "-p",
        "babble-store",
        "--test",
        "blobs"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "env",
      "args": [
        "CARGO_INCREMENTAL=0",
        "cargo",
        "test",
        "--manifest-path",
        "backend/Cargo.toml",
        "-p",
        "babble-store",
        "--lib",
        "blobs::tests"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "env",
      "args": [
        "CARGO_INCREMENTAL=0",
        "cargo",
        "test",
        "--manifest-path",
        "backend/Cargo.toml",
        "-p",
        "babble-api",
        "--test",
        "resources"
      ],
      "expect_exit": 0
    }
  ]
}
