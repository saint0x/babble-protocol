{
  "version": 1,
  "name": "bundle-gateway",
  "steps": [
    {
      "type": "proc_when",
      "cmd": "env",
      "args": [
        "CARGO_INCREMENTAL=0",
        "cargo",
        "test",
        "--manifest-path",
        "backend/Cargo.toml",
        "-p",
        "babble-api",
        "--lib"
      ],
      "exit_code": 0,
      "times": 1
    },
    {
      "type": "proc_spawn",
      "cmd": "env",
      "args": [
        "CARGO_INCREMENTAL=0",
        "cargo",
        "test",
        "--manifest-path",
        "backend/Cargo.toml",
        "-p",
        "babble-api",
        "--lib"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_when",
      "cmd": "env",
      "args": [
        "CARGO_INCREMENTAL=0",
        "cargo",
        "test",
        "--manifest-path",
        "backend/Cargo.toml",
        "-p",
        "babble-runtime",
        "--test",
        "bundles",
        "-p",
        "babble-node",
        "--test",
        "bundles"
      ],
      "exit_code": 0,
      "times": 1
    },
    {
      "type": "proc_spawn",
      "cmd": "env",
      "args": [
        "CARGO_INCREMENTAL=0",
        "cargo",
        "test",
        "--manifest-path",
        "backend/Cargo.toml",
        "-p",
        "babble-runtime",
        "--test",
        "bundles",
        "-p",
        "babble-node",
        "--test",
        "bundles"
      ],
      "expect_exit": 0
    }
  ]
}
