{
  "version": 1,
  "name": "publication-retry-contract",
  "steps": [
    { "type": "proc_when", "cmd": "cargo", "args": ["test", "--manifest-path", "backend/Cargo.toml", "-p", "babel-api", "publication_retry"], "exit_code": 0, "times": 1 },
    { "type": "proc_when", "cmd": "cargo", "args": ["test", "--manifest-path", "backend/Cargo.toml", "-p", "babel-store", "publication"], "exit_code": 0, "times": 1 },
    { "type": "proc_spawn", "cmd": "cargo", "args": ["test", "--manifest-path", "backend/Cargo.toml", "-p", "babel-api", "publication_retry"], "expect_exit": 0 },
    { "type": "proc_spawn", "cmd": "cargo", "args": ["test", "--manifest-path", "backend/Cargo.toml", "-p", "babel-store", "publication"], "expect_exit": 0 }
  ]
}
