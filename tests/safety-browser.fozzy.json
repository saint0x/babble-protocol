{
  "version": 1,
  "name": "social-safety-browser-process-contract-not-live-evidence",
  "steps": [
    { "type": "trace_event", "name": "Scripted process contract only; no browser or API is executed", "fields": {} },
    { "type": "proc_when", "cmd": "node", "args": ["--check", "tests/safety-browser.mjs"], "exit_code": 0, "times": 1 },
    { "type": "proc_spawn", "cmd": "node", "args": ["--check", "tests/safety-browser.mjs"], "expect_exit": 0 },
    { "type": "proc_when", "cmd": "node", "args": ["tests/safety-browser.mjs", "--contract-check"], "exit_code": 0, "times": 1 },
    { "type": "proc_spawn", "cmd": "node", "args": ["tests/safety-browser.mjs", "--contract-check"], "expect_exit": 0 },
    { "type": "proc_when", "cmd": "env", "args": ["BABBLE_LIVE_FOCUS=safety", "node", "tests/live-stack.mjs"], "exit_code": 0, "times": 1 },
    { "type": "proc_spawn", "cmd": "env", "args": ["BABBLE_LIVE_FOCUS=safety", "node", "tests/live-stack.mjs"], "expect_exit": 0 }
  ]
}
