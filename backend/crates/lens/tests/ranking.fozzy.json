{
  "version": 1,
  "name": "ranking-contract-process-harness",
  "steps": [
    {"type": "trace_event", "name": "Scripted process harness only; ranking-host.fozzy.json runs the real native tests"},
    {
      "type": "proc_when",
      "cmd": "/usr/bin/env",
      "args": ["CARGO_INCREMENTAL=0", "cargo", "test", "--manifest-path", "Cargo.toml", "--locked", "--tests", "--quiet"],
      "exit_code": 0,
      "times": 1
    },
    {
      "type": "proc_spawn",
      "cmd": "/usr/bin/env",
      "args": ["CARGO_INCREMENTAL=0", "cargo", "test", "--manifest-path", "Cargo.toml", "--locked", "--tests", "--quiet"],
      "expect_exit": 0
    }
  ]
}
