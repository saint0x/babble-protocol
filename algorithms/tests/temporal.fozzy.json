{
  "version": 1,
  "name": "python-temporal-deterministic-contract",
  "steps": [
    {
      "type": "proc_when",
      "cmd": "uv",
      "args": ["run", "--frozen", "python", "tests/run_temporal_checks.py"],
      "exit_code": 0,
      "stdout": "temporal full Python pytest, basedpyright, and ruff checks passed\n",
      "times": 1
    },
    {
      "type": "proc_spawn",
      "cmd": "uv",
      "args": ["run", "--frozen", "python", "tests/run_temporal_checks.py"],
      "expect_exit": 0,
      "expect_stdout": "temporal full Python pytest, basedpyright, and ruff checks passed\n",
      "expect_stderr": ""
    }
  ]
}
